From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhcn <zhcn@local>
Date: Mon, 16 Nov 2026 14:44:04 +0800
Subject: [PATCH 01/19] i18n infra: zellij-i18n workspace member, i18n.js
 hashed asset

---
 .gitignore                      | 2 ++
 Cargo.lock                      | 4 ++++
 Cargo.toml                      | 2 ++
 xtask/src/assets.rs             | 1 +
 zellij-client/assets/index.html | 1 +
 5 files changed, 10 insertions(+)

diff --git a/.gitignore b/.gitignore
index de56db3..af9355a 100644
--- a/.gitignore
+++ b/.gitignore
@@ -4,3 +4,5 @@ target/
 .vim
 .idea
 .DS_Store
+/zellij-i18n/
+/zellij-client/assets/i18n.js
diff --git a/Cargo.lock b/Cargo.lock
index 106b379..a57c77d 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -6542,6 +6542,10 @@ dependencies = [
  "zellij-utils",
 ]
 
+[[package]]
+name = "zellij-i18n"
+version = "0.1.0"
+
 [[package]]
 name = "zellij-integration-tests"
 version = "0.46.0"
diff --git a/Cargo.toml b/Cargo.toml
index 8c47bad..8f430b9 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -62,6 +62,7 @@ members = [
     "default-plugins/prompt",
     "default-plugins/context-menu",
     "zellij-client",
+    "zellij-i18n",
     "zellij-integration-tests",
     "zellij-server",
     "zellij-utils",
@@ -137,6 +138,7 @@ names = { version = "0.14.0", default-features = false }
 include_dir = { version = "0.7.3", default-features = false }
 sha2 = { version = "0.11", default-features = false }
 zellij-server = { path = "zellij-server/", version = "0.46.0" }
+zellij-i18n = { path = "zellij-i18n/" }
 zellij-utils = { path = "zellij-utils/", version = "0.46.0" }
 
 [profile.dev]
diff --git a/xtask/src/assets.rs b/xtask/src/assets.rs
index 0fc63ce..ce1f4ef 100644
--- a/xtask/src/assets.rs
+++ b/xtask/src/assets.rs
