@@ -2529,6 +2531,7 @@ dependencies = [
  "miette 7.6.0",
  "strip-ansi-escapes",
  "unicode-width 0.2.2",
+ "zellij-i18n",
  "zellij-tile",
 ]
 
@@ -3656,6 +3659,7 @@ version = "0.1.0"
 dependencies = [
  "fuzzy-matcher",
  "uuid",
+ "zellij-i18n",
