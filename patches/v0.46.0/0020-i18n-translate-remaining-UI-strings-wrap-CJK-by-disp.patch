-// Splits a whitespace-delimited word into the pieces a line may break between:
-// every double-width character (CJK has no spaces to break at) is its own
-// piece, runs of narrow characters stay together.
-fn word_pieces(word: &str) -> Vec<&str> {
-    let mut pieces = vec![];
-    let mut start = 0;
-    for (index, character) in word.char_indices() {
-        let wide = zellij_tile::graphemes::display_width(&word[index..index + character.len_utf8()]) > 1;
-        if wide {
-            if start < index {
-                pieces.push(&word[start..index]);
-            }
-            pieces.push(&word[index..index + character.len_utf8()]);
-            start = index + character.len_utf8();
-        }
-    }
-    if start < word.len() {
-        pieces.push(&word[start..]);
-    }
-    pieces
-}
-
-// Closing punctuation must not start a line.
-fn cannot_start_a_line(piece: &str) -> bool {
-    matches!(
-        piece,
-        "，" | "。" | "、" | "；" | "：" | "！" | "？" | "）" | "”" | "’" | "》" | "」" | "…"
-    )
-}
-
 pub fn wrap(text: &str, width: usize) -> Vec<String> {
-    let width = width.max(10);
-    let mut lines = vec![];
-    let mut current = String::new();
-    let mut current_width = 0;
-    for word in text.split_whitespace() {
-        for (index, piece) in word_pieces(word).into_iter().enumerate() {
-            let separator = if index == 0 && !current.is_empty() { " " } else { "" };
-            let piece_width = zellij_tile::graphemes::display_width(piece);
-            // compare display width rather than char count: CJK cells are 2 wide
-            if current_width + separator.len() + piece_width > width
-                && !current.is_empty()
-                && !cannot_start_a_line(piece)
-            {
-                lines.push(std::mem::take(&mut current));
-                current = piece.to_owned();
-                current_width = piece_width;
-            } else {
-                current.push_str(separator);
-                current.push_str(piece);
-                current_width += separator.len() + piece_width;
-            }
-        }
-    }
-    if !current.is_empty() {
-        lines.push(current);
-    }
-    lines
+    // by display width, and also for text without spaces (CJK)
+    zellij_i18n::wrap_by_width(text, width.max(10), &zellij_tile::graphemes::display_width)
 }
 
