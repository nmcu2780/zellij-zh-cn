+    /// Colors every `<...>` key token (such as `<Ctrl a>`) wherever it appears in
+    /// the text, independent of position and language.
+    pub fn color_keys(mut self, index_level: usize) -> Self {
+        let mut ranges = vec![];
+        let mut open: Option<usize> = None;
+        for (index, character) in self.text.chars().enumerate() {
+            match (character, open) {
+                ('<', None) => open = Some(index),
+                ('>', Some(start)) => {
+                    ranges.push(start..index + 1);
+                    open = None;
+                },
+                _ => {},
+            }
+        }
+        for range in ranges {
+            self = self.color_range(index_level, range);
+        }
+        self
+    }
+
     pub fn color_all(self, index_level: usize) -> Self {
         self.color_range(index_level, ..)
     }
