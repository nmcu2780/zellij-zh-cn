+/// Characters of the label before the URL including the space that follows it.
+fn url_prefix_len() -> usize {
+    tr("Enter Plugin URL: {url}")
+        .split("{url}")
+        .next()
+        .unwrap_or("")
+        .chars()
+        .count()
+}
+
+/// Characters of the "Enter Plugin URL:" label (everything before the URL).
+fn url_label_len() -> usize {
+    tr("Enter Plugin URL: {url}")
+        .split("{url}")
+        .next()
+        .unwrap_or("")
+        .trim_end()
+        .chars()
+        .count()
+}
+
+/// Characters of the label before the first `<` or `[` key group, without trailing space.
+fn title_label_len(title: &str) -> usize {
+    let end = title.find(['<', '[']).unwrap_or(title.len());
+    title[..end].trim_end().chars().count()
+}
+
+/// Characters of the " SEARCH: " prefix before the typed term.
+fn search_prefix_len() -> usize {
+    tr(" SEARCH: {term}_")
+        .split("{term}")
+        .next()
+        .unwrap_or("")
+        .chars()
+        .count()
+}
