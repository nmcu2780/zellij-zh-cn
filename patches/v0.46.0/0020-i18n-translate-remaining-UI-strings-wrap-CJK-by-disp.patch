+/// Text with every key of a combo like "Ctrl g + o + w" highlighted wherever the
+/// combo appears in `source` (so it works at any position in any language).
+pub fn combo_text(source: &str, level: usize, combo: &str) -> Text {
+    let mut text = Text::from(source);
+    if let Some(byte) = source.find(combo) {
+        let mut offset = source[..byte].chars().count();
+        for key in combo.split(" + ") {
+            let length = key.chars().count();
+            text = text.color_range(level, offset..offset + length);
+            offset += length + 3;
+        }
     }
+    text
 }
