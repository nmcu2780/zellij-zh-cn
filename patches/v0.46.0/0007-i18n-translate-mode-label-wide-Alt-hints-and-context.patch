 pub fn mode_label(mode: InputMode) -> String {
-    format!("{:?}", mode).to_uppercase()
+    match mode {
+        InputMode::Normal => tr("NORMAL"),
+        InputMode::Locked => tr("LOCKED"),
+        InputMode::Resize => tr("RESIZE"),
+        InputMode::Pane => tr("PANE"),
+        InputMode::Tab => tr("TAB"),
+        InputMode::Scroll => tr("SCROLL"),
+        InputMode::EnterSearch => tr("ENTER SEARCH"),
+        InputMode::Search => tr("SEARCH"),
+        InputMode::RenameTab => tr("RENAME TAB"),
+        InputMode::RenamePane => tr("RENAME PANE"),
+        InputMode::RenameSession => tr("RENAME SESSION"),
+        InputMode::Session => tr("SESSION"),
+        InputMode::Move => tr("MOVE"),
+        InputMode::Prompt => tr("PROMPT"),
+        InputMode::Tmux => "TMUX",
+    }
+    .to_owned()
 }
 
