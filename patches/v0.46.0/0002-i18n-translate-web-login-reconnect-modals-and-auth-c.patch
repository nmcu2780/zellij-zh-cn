diff --git a/zellij-client/assets/utils.js b/zellij-client/assets/utils.js
index 49a2f71..8efd8a4 100644
--- a/zellij-client/assets/utils.js
+++ b/zellij-client/assets/utils.js
@@ -2,6 +2,27 @@
  * Utility functions for the terminal web client
  */
 
+/**
+ * Translate an English UI string through window.zellijI18n (loaded from
+ * assets/i18n.js). Falls back to the English text when the catalog is absent.
+ * Named `{name}` placeholders are replaced from `params`.
+ * @param {string} en - English original, used as the catalog key
+ * @param {Object} [params] - values for `{name}` placeholders
+ * @returns {string} localized text
+ */
+export function t(en, params) {
+    if (window.zellijI18n) {
+        return window.zellijI18n.t(en, params);
+    }
+    let s = en;
+    if (params) {
+        for (const name in params) {
+            s = s.split(`{${name}}`).join(String(params[name]));
+        }
+    }
+    return s;
+}
+
 /**
  * Check if the current page is served over HTTPS
  * @returns {boolean} true if protocol is https:, false otherwise
