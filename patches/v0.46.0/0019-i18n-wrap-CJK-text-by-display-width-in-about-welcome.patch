+    #[test]
+    fn text_without_spaces_wraps_by_display_width() {
+        let text = "关闭此窗口后，会话保持运行，可从会话列表重新打开。";
+        let wrapped = wrap(text, 20);
+        assert!(wrapped.len() > 1);
+        for line in &wrapped {
+            assert!(zellij_tile::graphemes::display_width(line) <= 20 + 2, "{}", line);
+            assert!(!line.starts_with('，') && !line.starts_with('。'), "{}", line);
+        }
+        assert_eq!(wrapped.concat(), text);
+    }
+
+    #[test]
+    fn english_wrapping_is_unchanged() {
+        assert_eq!(
+            wrap("one two three four five six seven", 12),
+            vec!["one two", "three four", "five six", "seven"]
+        );
+    }
