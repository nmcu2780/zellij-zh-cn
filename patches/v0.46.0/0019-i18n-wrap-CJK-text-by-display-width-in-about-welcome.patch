-            current = candidate;
+        for (index, piece) in word_pieces(word).into_iter().enumerate() {
+            let separator = if index == 0 && !current.is_empty() { " " } else { "" };
+            let piece_width = zellij_tile::graphemes::display_width(piece);
+            // compare display width rather than char count: CJK cells are 2 wide
+            if current_width + separator.len() + piece_width > width
+                && !current.is_empty()
+                && !cannot_start_a_line(piece)
+            {
+                lines.push(std::mem::take(&mut current));
+                current = piece.to_owned();
