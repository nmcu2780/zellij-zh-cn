Subject: [PATCH 11/19] i18n: translate inline-key shortcut labels in status
 bar wide hints

---
 default-plugins/bars/src/status_bar/one_line_ui.rs | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/default-plugins/bars/src/status_bar/one_line_ui.rs b/default-plugins/bars/src/status_bar/one_line_ui.rs
index 5eca2b3..6f8d0d6 100644
--- a/default-plugins/bars/src/status_bar/one_line_ui.rs
+++ b/default-plugins/bars/src/status_bar/one_line_ui.rs
@@ -991,7 +991,7 @@ fn secondary_keybinds(help: &ModeInfo, tab_info: Option<&TabInfo>, max_len: usiz
                 ));
                 line.append(&add_shortcut(
                     help,
-                    "Resize",
+                    tr("Resize"),
                     &resize_shortcuts,
                     false,
                     Some(0),
@@ -999,7 +999,7 @@ fn secondary_keybinds(help: &ModeInfo, tab_info: Option<&TabInfo>, max_len: usiz
             }
             line.append(&add_shortcut(
                 help,
-                "Floating",
+                tr("Floating"),
                 &toggle_floating_key_to_display,
                 are_floating_panes_visible,
                 Some(0),
@@ -1040,7 +1040,7 @@ fn secondary_keybinds(help: &ModeInfo, tab_info: Option<&TabInfo>, max_len: usiz
                 ));
                 line.append(&add_shortcut_with_inline_key(
                     help,
-                    "Resize",
+                    tr("Resize"),
                     strip(&resize_shortcuts),
                     false,
                     &common_modifiers,
@@ -1048,7 +1048,7 @@ fn secondary_keybinds(help: &ModeInfo, tab_info: Option<&TabInfo>, max_len: usiz
             }
             line.append(&add_shortcut_with_inline_key(
                 help,
-                "Floating",
+                tr("Floating"),
                 strip(&toggle_floating_key_to_display),
                 are_floating_panes_visible,
                 &common_modifiers,
