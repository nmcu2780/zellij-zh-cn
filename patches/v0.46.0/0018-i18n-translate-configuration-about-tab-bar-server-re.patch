 pub fn window_welcome_points(only_missing: bool) -> Vec<String> {
     let mut lines = vec![];
     if !only_missing {
         lines.push(
-            "Closing this window keeps your sessions running, reopen them from the session list."
+            tr("Closing this window keeps your sessions running, reopen them from the session list.")
                 .to_owned(),
         );
         lines.push(
-            "The tray icon shows when something needs you, click it for the inbox and sessions."
+            tr("The tray icon shows when something needs you, click it for the inbox and sessions.")
                 .to_owned(),
         );
         lines.push(
-            "Desktop notifications tell you when a command finishes, fails or needs you. Choose \
-             which in Settings → Notifications."
+            tr("Desktop notifications tell you when a command finishes, fails or needs you. Choose \
+             which in Settings → Notifications.")
                 .to_owned(),
         );
         lines.push(
-            "Right-click Zellij's icon in the app menu or taskbar for Show Inbox and Show \
-             Sessions."
+            tr("Right-click Zellij's icon in the app menu or taskbar for Show Inbox and Show \
+             Sessions.")
                 .to_owned(),
         );
     }
