+
+    #[test]
+    fn mode_label_len_matches_rendered_display_width() {
+        // Mode labels may be localized (e.g. Chinese needs two cells per
+        // character); the recorded len must equal the rendered display width,
+        // not the byte length.
+        for action in [
+            KeyAction::Lock,
+            KeyAction::Pane,
+            KeyAction::Session,
+            KeyAction::Resize,
+        ] {
+            let key = KeyShortcut::new(
+                KeyMode::Unselected,
+                action,
+                Some(KeyWithModifier::new(BareKey::Char('0'))),
+            );
+            let color = colored_elements();
+            let ret = long_mode_shortcut(&key, color, "+", &vec![], false);
+            let len = ret.len;
+            let rendered = unstyle(ret);
+            assert_eq!(len, display_width(&rendered), "{:?}", action);
+        }
+    }
 }
