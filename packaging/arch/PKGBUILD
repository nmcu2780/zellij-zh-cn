# 草案：未经 makepkg 完整构建验证（首次使用请先 `makepkg -f` 并核对产物）。
#
# 本包把“上游 v0.46.0 + 本仓库补丁”构建出的 zellij 安装为独立命令 `zellij-zh`，
# 不覆盖系统的 /usr/bin/zellij，两者可并存。
#
# 用法（在本仓库内）：
#   cd packaging/arch && makepkg -f      # 只构建，不安装
#   sudo pacman -U zellij-zh-cn-*.pkg.tar.zst   # 确认产物后再安装
#
# 说明：构建直接使用本仓库的 tools/zhcn.py（版本检测与补丁校验都在其中），
# 上游版本与提交以仓库根目录的 upstream.toml 为准；补丁无法应用则构建失败。
pkgname=zellij-zh-cn
pkgver=0.46.0
pkgrel=1
pkgdesc="Zellij terminal workspace with Simplified Chinese UI (unofficial patched build, installed as zellij-zh)"
arch=('x86_64')
url="https://github.com/nmcu2780/zellij-zh-cn"
license=('MIT')
makedepends=('git' 'rustup' 'protobuf' 'python')
options=('!strip' '!lto')

build() {
    cd "$startdir/../.."
    python3 tools/zhcn.py fetch
    python3 tools/zhcn.py check
    python3 tools/zhcn.py build
}

package() {
    cd "$startdir/../.."
    local out=.work/zellij/target/release
    install -Dm755 "$out/zellij" "$pkgdir/usr/lib/zellij-zh-cn/zellij"
    install -Dm644 "$out/zellij.zh-buildinfo.json" "$pkgdir/usr/lib/zellij-zh-cn/zellij.zh-buildinfo.json"
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/zellij-zh-cn/zellij "$pkgdir/usr/bin/zellij-zh"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
